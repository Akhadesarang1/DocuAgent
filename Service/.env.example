# Python services (AiAgent, Docbuilder, Uml) environment variables

# Google Gemini API key. REQUIRED by AiAgent.py and Uml.py.
GEMINI_API_KEY=your_gemini_api_key

# Each service reads PORT independently. Run them separately with the port
# that matches its role, e.g.:
#   AiAgent.py     -> PORT=5001
#   Docbuilder.py  -> PORT=5002 (default)
PORT=5001

# Service-to-service URLs (defaults point at the deployed instances;
# override for local dev)
DOCBUILDER_URL=http://localhost:5002
PARENT_AGENT_URL=http://localhost:5001
UML_AGENT_URL=http://localhost:5003

# Directory Uml.py writes generated diagram images to
STATIC_DIR=static
