# Server (Node.js gateway) environment variables

# Port the Express gateway listens on
PORT=3001

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/gendocai_db

# Secret used to sign/verify JWTs. REQUIRED — the server refuses to start without it.
JWT_SECRET=change_me_to_a_long_random_string

# URL of the Python DocBuilder service
DOC_BUILDER_URL=http://localhost:5002

# Set to "production" to serve the built Client and enable SPA fallback
NODE_ENV=development
